{
  "name": "snails",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @snails/server --filter @snails/display --filter @snails/controller dev",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm build:packages && pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" --filter \"!@snails/server\" build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-limits": "node scripts/check-limits.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm check-limits && pnpm test && pnpm build",
    "build:packages": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" --filter @snails/server build",
    "sim:ai": "pnpm build:packages && pnpm sim:ai:run",
    "sim:ai:run": "node packages/ai/dist/sim-ai/cli.js",
    "sim:balance": "pnpm build:packages && node packages/ai/dist/balance/cli.js",
    "e2e": "node e2e/smoke.mjs && node e2e/demo.mjs",
    "shots": "node e2e/shots.mjs",
    "perf": "node e2e/perf.mjs",
    "e2e:reconnect": "node e2e/reconnect.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.15.0",
    "eslint-plugin-jsdoc": "^50.5.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "type": "module"
}
